# Convex
# From `npx convex dev` / the Convex dashboard
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk (Next.js)
# From https://dashboard.clerk.com → API keys, or `npx clerk init`
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Clerk Frontend API URL (issuer) — also required on the Convex deployment:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://verb-noun-00.clerk.accounts.dev
# Activate the Convex integration first:
#   https://dashboard.clerk.com/apps/setup/convex
CLERK_JWT_ISSUER_DOMAIN=

# LLM for Matchmaker RAG chatbot (set on the Convex deployment with `npx convex env set`)
#
# Chat (OptiPrime — Azure Responses API; separate from embeddings):
#   npx convex env set OPENAI_CHAT_API_KEY <optiprime-api-key>
#   npx convex env set OPENAI_CHAT_BASE_URL https://optiprimeai-resource.services.ai.azure.com   # default if unset
#   npx convex env set OPENAI_CHAT_MODEL <chat-deployment-name>                                 # optional, default gpt-4o-mini
#
# Embeddings (CodeEcho — vector index; separate key/endpoint):
#   npx convex env set OPENAI_BASE_URL https://codeecho-resource.services.ai.azure.com
#   npx convex env set OPENAI_API_KEY <codeecho-api-key>
#   npx convex env set OPENAI_EMBEDDING_MODEL <embedding-deployment>                            # optional, default text-embedding-3-small
#
# Aliases: OPENAI_CHAT_BASE_URL ↔ AZURE_CHAT_ENDPOINT; OPENAI_CHAT_API_KEY ↔ AZURE_CHAT_API_KEY;
# OPENAI_BASE_URL ↔ AZURE_OPENAI_ENDPOINT / AZURE_BASE_URL; OPENAI_API_KEY ↔ AZURE_API_KEY / AZURE_OPENAI_API_KEY.
OPENAI_CHAT_API_KEY=
OPENAI_CHAT_BASE_URL=
OPENAI_CHAT_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_EMBEDDING_MODEL=
